{
    "name": "keke-backend",
    "version": "0.1.0",
    "private": true,
    "description": "Keke backend Phase 1: authentication and role-based access",
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/main",
        "format": "prettier --write \"src/**/*.ts\"",
        "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
        "db:rollback": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "@apollo/server": "^5.5.2",
        "@as-integrations/express5": "^1.1.2",
        "@nestjs/apollo": "^13.2.3",
        "@nestjs/common": "^11.0.0",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.0",
        "@nestjs/graphql": "^13.2.3",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/platform-express": "^11.0.0",
        "@nestjs/swagger": "^11.4.8",
        "@nestjs/throttler": "^6.0.0",
        "@nestjs/typeorm": "^11.0.0",
        "bcryptjs": "^3.0.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "dotenv": "^16.4.0",
        "graphql": "^16.15.0",
        "ioredis": "^5.0.0",
        "joi": "^18.3.2",
        "pg": "^8.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.0",
        "typeorm": "^0.3.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "prettier": "^3.10.1",
        "ts-node": "^10.9.0",
        "tsconfig-paths": "^4.2.0",
        "typeorm-ts-node-commonjs": "^0.3.20",
        "typescript": "^5.7.0"
    }
}
